  },
  "files": ["bin", "kit", "tools", "fonts", "skills", ".claude-plugin", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc -p ."
  },
  "dependencies": {
